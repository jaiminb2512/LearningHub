generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"] 
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [vector]   
}

model User {
  userId               String         @id
  fullName             String
  emailId              String         @unique
  password             String

  isDeleted            Boolean        @default(false)
  updatedBy            String?
  updatedAt            DateTime?      @updatedAt
  createdAt            DateTime       @default(now())

  threads              Thread[]       @relation("ThreadCreatedBy")
  documents            Document[]     @relation("UserDocuments")
  createdSystemPrompts SystemPrompt[] @relation("SystemPromptCreatedBy")
  updatedSystemPrompts SystemPrompt[] @relation("SystemPromptUpdatedBy")
  books                Book[]         @relation("UserBooks")
  notes                Note[]         @relation("UserNotes")
  aiSettings           AiSetting[]    @relation("UserAiSettings")
}

model Thread {
  threadId       String  @id @default(uuid())
  title          String
  userId         String
  systemPromptId String?
  aiSettingId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator      User          @relation("ThreadCreatedBy", fields: [userId], references: [userId], onDelete: Cascade)
  systemPrompt SystemPrompt? @relation(fields: [systemPromptId], references: [systemPromptId], onDelete: SetNull)
  aiSetting    AiSetting?    @relation(fields: [aiSettingId], references: [aiSettingId], onDelete: SetNull)

  messages  Message[]
  documents Document[] @relation("ThreadDocuments")
  books     Book[]     @relation("ThreadBooks")
  notes     Note[]     @relation("ThreadNotes")

  @@index([userId])
  @@index([aiSettingId])
}

model Message {
  messageId    String  @id @default(uuid())
  threadId     String
  role         String
  content      String
  model        String
  provider     String
  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?
  sequence     Int     @default(0)

  // Link AI responses to user questions
  questionId String?
  question   Message?  @relation("MessageHistory", fields: [questionId], references: [messageId], onDelete: SetNull)
  answers    Message[] @relation("MessageHistory")

  createdAt DateTime @default(now())
  thread    Thread   @relation(fields: [threadId], references: [threadId], onDelete: Cascade)

  documents Document[] @relation("MessageDocuments")

  @@index([threadId])
  @@index([questionId])
}

model SystemPrompt {
  systemPromptId String  @id @default(uuid())
  name           String
  prompt         String
  isDeleted      Boolean @default(false)

  createdBy String
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator User     @relation("SystemPromptCreatedBy", fields: [createdBy], references: [userId], onDelete: Restrict)
  updater User?    @relation("SystemPromptUpdatedBy", fields: [updatedBy], references: [userId], onDelete: SetNull)

  threads Thread[]

  @@index([createdBy])
}

model Document {
  id        String @id @default(uuid())
  userId    String
  threadId  String
  messageId String

  embedding           Unsupported("vector(3072)")
  embeddingModel      String
  embeddingDimensions Int      @default(3072)
  embeddedAt          DateTime @default(now())

  user    User    @relation("UserDocuments", fields: [userId], references: [userId], onDelete: Cascade)
  thread  Thread  @relation("ThreadDocuments", fields: [threadId], references: [threadId], onDelete: Cascade)
  message Message @relation("MessageDocuments", fields: [messageId], references: [messageId], onDelete: Cascade)

  @@index([userId])
  @@index([threadId])
  @@index([messageId])
  @@index([embeddingModel])
}

model Book {
  bookId      String   @id @default(uuid())
  userId      String
  threadId    String?
  title       String
  description String?
  summary     String?
  status      String   @default("ACTIVE")
  sourceType  String   @default("MANUAL")
  isDefault   Boolean  @default(false)
  isDeleted   Boolean  @default(false)
  createdBy   String
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation("UserBooks", fields: [userId], references: [userId], onDelete: Cascade)
  thread Thread? @relation("ThreadBooks", fields: [threadId], references: [threadId], onDelete: SetNull)
  notes  Note[]

  @@index([userId])
  @@index([userId, isDeleted, status])
  @@index([userId, isDefault])
  @@index([updatedAt])
}

model Note {
  noteId     String   @id @default(uuid())
  bookId     String
  userId     String
  threadId   String?
  title      String
  content    String
  format     String   @default("markdown")
  status     String   @default("ACTIVE")
  summary    String?
  section    String?
  orderIndex Int      @default(0)
  isDeleted  Boolean  @default(false)
  createdBy  String
  updatedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  book   Book    @relation(fields: [bookId], references: [bookId], onDelete: Cascade)
  user   User    @relation("UserNotes", fields: [userId], references: [userId], onDelete: Cascade)
  thread Thread? @relation("ThreadNotes", fields: [threadId], references: [threadId], onDelete: SetNull)

  @@index([bookId])
  @@index([bookId, isDeleted, orderIndex])
  @@index([userId])
  @@index([userId, isDeleted, status])
  @@index([threadId])
  @@index([updatedAt])
}

model AiSetting {
  aiSettingId  String   @id @default(uuid())
  name         String
  userId       String
  settingsJson Json

  createdAt DateTime @default(now())

  user    User     @relation("UserAiSettings", fields: [userId], references: [userId], onDelete: Cascade)
  threads Thread[]

  @@index([userId])
}
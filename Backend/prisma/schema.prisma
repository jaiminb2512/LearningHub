generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"] 
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [vector]   
}

model User {
  userId               String         @id
  fullName             String
  emailId              String         @unique
  password             String

  isDeleted            Boolean        @default(false)
  updatedBy            String?
  updatedAt            DateTime?      @updatedAt
  createdAt            DateTime       @default(now())

  threads              Thread[]       @relation("ThreadCreatedBy")
  documents            Document[]     @relation("UserDocuments")
  createdSystemPrompts SystemPrompt[] @relation("SystemPromptCreatedBy")
  updatedSystemPrompts SystemPrompt[] @relation("SystemPromptUpdatedBy")
  books                Book[]         @relation("UserBooks")
  notes                Note[]         @relation("UserNotes")
  aiSettings           AiSetting[]    @relation("UserAiSettings")
  knowledgeSources     KnowledgeSource[] @relation("UserKnowledgeSources")
  longTermMemories LongTermMemory[] @relation("UserLongTermMemories")
  memoryGenerationTasks MemoryGenerationTask[] @relation("UserMemoryGenerationTasks")
}

model Thread {
  threadId       String  @id @default(uuid())
  title          String
  userId         String
  systemPromptId String?
  aiSettingId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator      User          @relation("ThreadCreatedBy", fields: [userId], references: [userId], onDelete: Cascade)
  systemPrompt SystemPrompt? @relation(fields: [systemPromptId], references: [systemPromptId], onDelete: SetNull)
  aiSetting    AiSetting?    @relation(fields: [aiSettingId], references: [aiSettingId], onDelete: SetNull)
  sourceMemories LongTermMemory[] @relation("MemorySourceThread")

  messages  Message[]
  documents Document[] @relation("ThreadDocuments")
  books     Book[]     @relation("ThreadBooks")
  notes     Note[]     @relation("ThreadNotes")
  knowledgeLinks ThreadKnowledgeSource[]
  summaries      Summary[]

  @@index([userId])
  @@index([aiSettingId])
  memoryGenerationTasks MemoryGenerationTask[] @relation("ThreadMemoryGenerationTasks")
}

model Message {
  messageId    String  @id @default(uuid())
  threadId     String
  role         String
  content      String
  model        String
  provider     String
  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?
  sequence     Int     @default(0)
  /// Full prompt text sent to the model for this assistant turn
  promptText   String?
  /// AI setting used when this assistant reply was generated
  aiSettingId  String?

  // Link AI responses to user questions
  questionId String?
  question   Message?  @relation("MessageHistory", fields: [questionId], references: [messageId], onDelete: SetNull)
  answers    Message[] @relation("MessageHistory")

  createdAt DateTime @default(now())
  thread    Thread   @relation(fields: [threadId], references: [threadId], onDelete: Cascade)
  aiSetting AiSetting? @relation(fields: [aiSettingId], references: [aiSettingId], onDelete: SetNull)
  sourceMemories LongTermMemory[] @relation("MemorySourceMessage")

  documents Document[] @relation("MessageDocuments")
  summaries  Summary[]  @relation("MessageSummaries")

  @@index([threadId])
  @@index([questionId])
  @@index([aiSettingId])
  memoryGenerationTasks MemoryGenerationTask[] @relation("MessageMemoryGenerationTasks")
}
  
model Summary {
  summaryId                  String   @id @default(uuid())
  threadId                   String
  summary                    String
  lastSummarizedMessageId    String
  lastSummarizedMessageCount Int
  tokenCount                 Int
  createdAt                  DateTime @default(now())

  thread                Thread  @relation(fields: [threadId], references: [threadId], onDelete: Cascade)
  lastSummarizedMessage Message @relation("MessageSummaries", fields: [lastSummarizedMessageId], references: [messageId], onDelete: Cascade)

  @@index([threadId])
  @@index([lastSummarizedMessageId])
}

model LongTermMemory {
  longTermMemoryId   String @id @default(uuid())
  userId     String

  memoryType String     // PROFILE, PROJECT, EPISODIC, SEMANTIC, PERIODIC
  category   String
  content    String
  normalizedContent String
  fingerprint String

  metadata   Json?
  confidence Float?
  importance Int     @default(3)

  // ACTIVE, SUPERSEDED, ARCHIVED
  status String @default("ACTIVE")

  sourceThreadId  String?
  sourceMessageId String?

  embedding           Unsupported("vector(3072)")?
  embeddingModel      String?
  embeddingDimensions Int      @default(3072)
  embeddedAt          DateTime?

  validFrom      DateTime?
  validUntil     DateTime?
  lastAccessedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("UserLongTermMemories", fields: [userId], references: [userId], onDelete: Cascade)

  sourceThread Thread? @relation("MemorySourceThread", fields: [sourceThreadId], references: [threadId], onDelete: SetNull)

  sourceMessage Message? @relation("MemorySourceMessage", fields: [sourceMessageId], references: [messageId], onDelete: SetNull)

  @@unique([userId, fingerprint])

  @@index([userId, status])
  @@index([userId, memoryType, status])
  @@index([userId, category, status])
  @@index([sourceThreadId])
  @@index([sourceMessageId])
  @@index([updatedAt])
  memoryGenerationTasks MemoryGenerationTask[] @relation("LongTermMemoryGenerationTasks")
}

model SystemPrompt {
  systemPromptId String  @id @default(uuid())
  name           String
  prompt         String
  isDeleted      Boolean @default(false)

  createdBy String
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator User     @relation("SystemPromptCreatedBy", fields: [createdBy], references: [userId], onDelete: Restrict)
  updater User?    @relation("SystemPromptUpdatedBy", fields: [updatedBy], references: [userId], onDelete: SetNull)

  threads Thread[]

  @@index([createdBy])
}

model MemoryGenerationTask {
  taskId           String   @id @default(uuid())
  userId           String
  threadId         String
  longTermMemoryId String?   // optional link to LongTermMemory
  status           String   @default("PENDING") // PENDING, RUNNING, SUCCESS, FAILED
  errorMessage     String?
  attempts         Int      @default(0)
  scheduledAt      DateTime?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user          User          @relation("UserMemoryGenerationTasks", fields: [userId], references: [userId], onDelete: Cascade)
  thread        Thread        @relation("ThreadMemoryGenerationTasks", fields: [threadId], references: [threadId], onDelete: Cascade)
  longTermMemory LongTermMemory? @relation("LongTermMemoryGenerationTasks", fields: [longTermMemoryId], references: [longTermMemoryId], onDelete: SetNull)

  sourceMessageId String?
  outcome         String? // CREATED, UPDATED, DUPLICATE, NO_MEMORY
  sourceMessage Message? @relation("MessageMemoryGenerationTasks", fields: [sourceMessageId], references: [messageId], onDelete: SetNull)

  @@index([userId])
  @@index([threadId])
  @@index([status])
  @@unique([sourceMessageId])
}

model Document {
  id        String @id @default(uuid())
  userId    String
  threadId  String
  messageId String

  embedding           Unsupported("vector(3072)")
  embeddingModel      String
  embeddingDimensions Int      @default(3072)
  embeddedAt          DateTime @default(now())

  user    User    @relation("UserDocuments", fields: [userId], references: [userId], onDelete: Cascade)
  thread  Thread  @relation("ThreadDocuments", fields: [threadId], references: [threadId], onDelete: Cascade)
  message Message @relation("MessageDocuments", fields: [messageId], references: [messageId], onDelete: Cascade)

  @@index([userId])
  @@index([threadId])
  @@index([messageId])
  @@index([embeddingModel])
}

model Book {
  bookId      String   @id @default(uuid())
  userId      String
  threadId    String?
  title       String
  description String?
  summary     String?
  status      String   @default("ACTIVE")
  sourceType  String   @default("MANUAL")
  isDefault   Boolean  @default(false)
  isDeleted   Boolean  @default(false)
  createdBy   String
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation("UserBooks", fields: [userId], references: [userId], onDelete: Cascade)
  thread Thread? @relation("ThreadBooks", fields: [threadId], references: [threadId], onDelete: SetNull)
  notes  Note[]

  @@index([userId])
  @@index([userId, isDeleted, status])
  @@index([userId, isDefault])
  @@index([updatedAt])
}

model Note {
  noteId     String   @id @default(uuid())
  bookId     String
  userId     String
  threadId   String?
  title      String
  content    String
  format     String   @default("markdown")
  status     String   @default("ACTIVE")
  summary    String?
  section    String?
  orderIndex Int      @default(0)
  isDeleted  Boolean  @default(false)
  createdBy  String
  updatedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  book   Book    @relation(fields: [bookId], references: [bookId], onDelete: Cascade)
  user   User    @relation("UserNotes", fields: [userId], references: [userId], onDelete: Cascade)
  thread Thread? @relation("ThreadNotes", fields: [threadId], references: [threadId], onDelete: SetNull)

  @@index([bookId])
  @@index([bookId, isDeleted, orderIndex])
  @@index([userId])
  @@index([userId, isDeleted, status])
  @@index([threadId])
  @@index([updatedAt])
}

model AiSetting {
  aiSettingId  String   @id @default(uuid())
  name         String
  userId       String
  settingsJson Json

  createdAt DateTime @default(now())

  user     User      @relation("UserAiSettings", fields: [userId], references: [userId], onDelete: Cascade)
  threads  Thread[]
  messages Message[]

  @@index([userId])
}

/// User-owned uploaded file / knowledge item (not tied to a single thread)
model KnowledgeSource {
  knowledgeSourceId String   @id @default(uuid())
  userId            String
  bookId            String?
  originalName      String
  mimeType          String
  sizeBytes         Int
  storagePath       String?
  status            String   @default("PROCESSING") // PROCESSING | READY | FAILED
  errorMessage      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user    User                     @relation("UserKnowledgeSources", fields: [userId], references: [userId], onDelete: Cascade)
  chunks  KnowledgeChunk[]
  threads ThreadKnowledgeSource[]

  @@index([userId])
  @@index([userId, status])
}

/// Many-to-many: attach the same knowledge file to one or more threads
model ThreadKnowledgeSource {
  id                String   @id @default(uuid())
  threadId          String
  knowledgeSourceId String
  attachedBy        String?
  attachedAt        DateTime @default(now())
  isActive          Boolean  @default(true)

  thread          Thread          @relation(fields: [threadId], references: [threadId], onDelete: Cascade)
  knowledgeSource KnowledgeSource @relation(fields: [knowledgeSourceId], references: [knowledgeSourceId], onDelete: Cascade)

  @@unique([threadId, knowledgeSourceId])
  @@index([threadId])
  @@index([knowledgeSourceId])
  @@index([threadId, isActive])
}

model KnowledgeChunk {
  knowledgeChunkId String                       @id @default(uuid())
  sourceId         String
  userId           String
  chunkIndex       Int
  content          String
  embedding        Unsupported("vector(3072)")?
  embeddingModel   String                       @default("gemini-embedding-001")
  tokenCount       Int?
  createdAt        DateTime                     @default(now())

  source KnowledgeSource @relation(fields: [sourceId], references: [knowledgeSourceId], onDelete: Cascade)

  @@index([sourceId])
  @@index([userId])
  @@index([sourceId, chunkIndex])
}
